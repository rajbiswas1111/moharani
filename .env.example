# The Moharani Environment Variables
PORT=3000
JWT_SECRET=moharani-dev-secret-change-in-production

# Database (Optional: falls back to data/store.json)
MONGO_URI=
MONGO_DB_NAME=themoharani

# OTP Providers (dev | brevo | twilio | fast2sms)
OTP_PROVIDER=dev
EMAIL_OTP_PROVIDER=dev
BREVO_API_KEY=
OTP_EMAIL_FROM=no-reply@themoharani.com
FAST2SMS_API_KEY=
FAST2SMS_SENDER=FSTSMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
